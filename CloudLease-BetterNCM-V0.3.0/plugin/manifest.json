{
  "$schema": "https://raw.githubusercontent.com/BetterNCM/BetterNCM-Plugins/refs/heads/master/manifest-schema.json",
  "manifest_version": 1,
  "name": "CloudLeaseManager",
  "slug": "cloud-lease-manager",
  "version": "0.3.0",
  "author": "CloudLease",
  "description": "网易云音乐旁置租期工作台：日历、实时时间、租期记录与记录管理",
  "betterncm_version": ">=1.3.4",
  "ncm3-compatible": true,
  "require_restart": true,
  "native_plugin": "native.dll",
  "injects": {
    "Main": [
      { "file": "main.js" }
    ]
  }
